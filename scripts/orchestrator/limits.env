# Orchestrator liveness limits, sourced by heartbeat.sh and gate-slot.sh; the environment overrides every key. Tune per repo.
# Every key is a number (EST_* may hold a fraction): the scripts read them in arithmetic, where a value such as
# x[$(cmd)] runs cmd, so any other value of one of these keys in the environment stops the script. Every other key
# is a whole number without a leading zero: bash arithmetic stops at a fraction and reads 010 as eight.
for _k in $(sed -n 's/^\([A-Z][A-Z_]*\)=.*/\1/p' "${BASH_SOURCE[0]}"); do
  case ${!_k:-0} in *[!0-9.]* | .* | *. | *.*.*) echo "limits.env: $_k='${!_k}' is not a number" >&2; exit 2 ;; esac
  case $_k=${!_k:-0} in EST_*) ;; *.* | *=0?*) echo "limits.env: $_k='${!_k}' is not a whole number" >&2; exit 2 ;; esac
done; unset _k
# Single source for these numbers: the designs and the skill link here, never copy them.
HB_EVERY=${HB_EVERY:-60}        # s between samples
HB_CPUMIN=${HB_CPUMIN:-2}       # CPU s per sample that count as activity
HB_PING=${HB_PING:-600}         # agent with no activity this long: event idle (ping it)
HB_STUCK=${HB_STUCK:-2700}      # agent with no progress (HEAD, worktree write, report) this long: event stuck (restart it)
HB_REPEAT=${HB_REPEAT:-900}     # re-emit an event, and re-alarm, while it still holds after this long
HB_UNACTED=${HB_UNACTED:-900}   # event or report unhandled this long: the orchestrator is not acting, alarm
HB_STALE=${HB_STALE:-300}       # no armed watch this long with jobs in flight: the orchestrator is not listening, alarm
HB_KILL=${HB_KILL:-1200}        # headless only: no armed watch this long: kill claude so the run wrapper relaunches it to resume
HB_LEASE=${HB_LEASE:-1680}      # watch lease, s (Monitor cap 1800); headless 540 (cap 600 under -p)
HB_STALL=${HB_STALL:-3}         # alarms in a row after which $S/status reads STALLED
# Hand-over (runbook TP-6): an agent cannot see its tokens, so a lead stops itself at CALL_CAP; the heartbeat measures both.
CONTEXT_CAP=${CONTEXT_CAP:-100000} # context tokens of an agent's last turn: event cap (hand it over to a fresh agent)
CALL_CAP=${CALL_CAP:-60}           # tool calls of an agent: event cap; a lead writes its handover and stops at this count
# Full gates (gate-slot.sh, runbook TP-2): one gate saturates GATE_CORES cores.
GATE_CORES=${GATE_CORES:-8}     # cores one full gate keeps busy
# Full gates at once on this host: nproc / GATE_CORES, at least 1; 2 when nproc fails.
GATE_SLOTS=${GATE_SLOTS:-$(n=$(nproc 2> /dev/null) || n=; c=$((GATE_CORES > 0 ? GATE_CORES : 1))
  case "$n" in "" | *[!0-9]*) echo 2 ;; *) echo $((n / c > 0 ? n / c : 1)) ;; esac)}
[ "$GATE_SLOTS" -ge 1 ] || { echo "limits.env: GATE_SLOTS='$GATE_SLOTS' serves no gate; at least 1" >&2; exit 2; }
GATE_POLL=${GATE_POLL:-15}      # s between slot checks of a queued gate
# Dispatch (runbook TP-1, TP-4): ready tasks and the gate slots set the agent count, not the plan.
IMPL_PER_SLOT=${IMPL_PER_SLOT:-2}                     # implementer agents per full-gate slot; more only queue for a slot
IMPL_CAP=${IMPL_CAP:-$((IMPL_PER_SLOT * GATE_SLOTS))} # implementer agents at once
LEAD_CAP=${LEAD_CAP:-2}         # lead agents at once
WEEK_CAP=${WEEK_CAP:-93}        # ceiling for week% plus the weekly points of the tasks in flight and the next one
EST_S=${EST_S:-0.5}             # weekly points of an S task
EST_M=${EST_M:-1}               # weekly points of an M task
EST_L=${EST_L:-3}               # weekly points of an L task
FRESH_AFTER=${FRESH_AFTER:-60}  # minutes after which a fix round goes to a fresh agent
# Job due times, minutes from launch (heartbeat.sh add takes a DUE_* name):
DUE_CODEX=${DUE_CODEX:-30}      # second-opinion CLI job
DUE_REVIEW=${DUE_REVIEW:-45}    # review agent
DUE_GATE=${DUE_GATE:-45}        # full gate
DUE_S=${DUE_S:-90}              # S task implementer
DUE_M=${DUE_M:-180}             # M task implementer
DUE_L=${DUE_L:-300}             # L task implementer
