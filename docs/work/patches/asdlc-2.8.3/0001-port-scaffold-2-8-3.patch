+    def test_heartbeat_start_hands_the_daemon_the_callers_settings(self) -> None:
+        # A transient unit starts with the user manager's environment, not the caller's.
+        with tempfile.TemporaryDirectory() as temp:
+            args = Path(temp) / "args"
